# =============================================================================
# GymVe — copia a `.env` (gitignored). Rota secretos si hubo filtración.
# =============================================================================

# development | production — en production se rechazan secretos débiles y CORS=*
GYMVE_ENV=development

# PostgreSQL (docker compose)
POSTGRES_SUPERUSER=postgres
POSTGRES_PASSWORD=genera-un-password-largo-para-postgres
POSTGRES_DB=gymve
POSTGRES_PORT=5432
# Usuario de aplicación (privilegios mínimos; creado en primer arranque del volumen)
GYMVE_APP_DB_USER=gymve_app
GYMVE_APP_DB_PASSWORD=genera-otro-password-largo-para-la-app

# SQLAlchemy — usar el usuario de aplicación, no el superusuario
DATABASE_URL=postgresql+psycopg://gymve_app:genera-otro-password-largo-para-la-app@localhost:5432/gymve

# Secreto para cookies web (PWA iPhone) y base de JWT (≥32 caracteres aleatorios)
SESSION_SECRET=genera-con-openssl-rand-base64-32-minimo-32-caracteres-aqui
# Opcional: clave distinta solo para tokens del APK Samsung
# JWT_SECRET=

# Servidor API (uvicorn en el PC Ubuntu)
GYMVE_HOST=0.0.0.0
GYMVE_PORT=8000

# CORS: en producción lista orígenes explícitos (HTTPS del túnel + PWA).
# Ejemplo: https://tu-tunel.trycloudflare.com,https://gymve.local
# En desarrollo puedes usar * (no recomendado si expones el puerto a LAN).
CORS_ORIGINS='*'

# Límite de intentos de login (web + API)
GYMVE_LOGIN_RATE_LIMIT=10/minute

# Solo desarrollo: cookies de sesión solo por HTTPS (activar con Caddy/túnel)
# GYMVE_SESSION_HTTPS_ONLY=1

# NO usar en producción — solo relaja comprobaciones en dev (ver docs/seguridad.md)
# GYMVE_ALLOW_INSECURE_DEV=1

# --- Seed (scripts/seed_users.py) — NO subas contraseñas al repo ---
# Genera hash: python scripts/hash_password.py
# Hashes bcrypt: usa comillas simples si Docker Compose trunca los $ → GYMVE_USER_1_PASSWORD_HASH='$2b$12$...'
GYMVE_USER_1_EMAIL=familia1@ejemplo.com
GYMVE_USER_1_NAME="Familia 1"
GYMVE_USER_1_PASSWORD_HASH=

GYMVE_USER_2_EMAIL=familia2@ejemplo.com
GYMVE_USER_2_NAME="Familia 2"
GYMVE_USER_2_PASSWORD_HASH=

GYMVE_USER_3_EMAIL=familia3@ejemplo.com
GYMVE_USER_3_NAME="Familia 3"
GYMVE_USER_3_PASSWORD_HASH=

GYMVE_USER_4_EMAIL=familia4@ejemplo.com
GYMVE_USER_4_NAME="Familia 4"
GYMVE_USER_4_PASSWORD_HASH=

# Alternativa JSON para seed:
# GYMVE_USERS_JSON=[{"email":"a@ejemplo.com","display_name":"Ana","password_hash":"$2b$..."}]

# --- Cliente Flet (Samsung / emulador Android en Ubuntu) ---
# Emulador → host: http://10.0.2.2:8000 | HTTPS local: https://gymve.local
# iPhone usa Safari/PWA (misma URL HTTPS), no lee esta variable.
# GYMVE_API_BASE_URL=https://gymve.local

# --- Emulador Android (scripts/run-android-emulator.sh) ---
# ANDROID_HOME=$HOME/Android/Sdk
# ANDROID_AVD=Pixel_7_API_34
